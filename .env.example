NUXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu_clave_anon
# Clave service_role (solo para el servidor), p. ej. para listar usuarios de auth en el panel admin
NUXT_SUPABASE_SECRET_KEY=tu_clave_service_role

# Credenciales para los integration tests contra el stack local de Supabase.
# Los valores se obtienen con `supabase status`.
SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_PUBLISHABLE_KEY=tu_publishable_key_local
SUPABASE_TEST_SERVICE_KEY=tu_secret_key_local
